{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "*",
          "claims": {
            "sub": "candidate",
            "name": "Candidate User",
            "email": "candidate@example.com",
            "roles": [
              "USER"
            ]
          }
        }
      ]
    }
  ]
}
