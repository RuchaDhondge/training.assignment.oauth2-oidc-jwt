{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "*profile:read*",
          "claims": {
            "sub": "peter-parker-123",
            "name": "Peter Parker",
            "email": "peter.parker@dailybugle.com"
          }
        },
        {
          "requestParam": "scope",
          "match": "*profile:write*",
          "claims": {
            "sub": "peter-parker-123",
            "name": "Peter Parker",
            "email": "peter.parker@dailybugle.com"
          }
        },
        {
          "requestParam": "scope",
          "match": "*",
          "claims": {
            "sub": "peter-parker-123",
            "name": "Peter Parker",
            "email": "peter.parker@dailybugle.com"
          }
        }
      ]
    }
  ]
}
